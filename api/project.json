{
  "name": "api",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "php artisan serve",
        "cwd": "api"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "php artisan migrate",
        "cwd": "api"
      }
    }
  }
}
